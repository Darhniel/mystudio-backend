# ===========================================================================
# MyStudio backend - environment template
# ===========================================================================
# Copy this file to `.env` and replace every placeholder:
#
#   Copy-Item .env.example .env
#
# `.env` is git-ignored and must never be committed. In production, set the
# same names in the hosting platform's secret manager instead of using a file.
#
# Legacy `DJANGO_`-prefixed names (DJANGO_SECRET_KEY, DJANGO_DEBUG,
# DJANGO_ALLOWED_HOSTS, DJANGO_CSRF_TRUSTED_ORIGINS, DJANGO_LOG_LEVEL) are
# still accepted as fallbacks, but the names below are canonical.
# ===========================================================================

# --- Core --------------------------------------------------------------
# Generate a real value for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
LOG_LEVEL=INFO

# --- Frontend origins (comma-separated) --------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database ----------------------------------------------------------
# PostgreSQL is required in development and production. Use a local server:
DATABASE_URL=postgresql://mystudio:change-me@localhost:5432/mystudio
#
# ...or a Supabase project. Session Pooler is IPv4-compatible and recommended:
# DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Supabase direct connection (IPv6-only on newer projects):
# DATABASE_URL=postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
#
# URL-encode special characters in the password:
#   python -c "from urllib.parse import quote; print(quote('your-password', safe=''))"
#
# Connection tuning (safe defaults; usually leave unchanged)
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True
DB_CONNECT_TIMEOUT=5
# Abort a single SQL statement after this many milliseconds (0 disables).
DB_STATEMENT_TIMEOUT_MS=60000
# Only when DATABASE_URL points at the Supabase Transaction Pooler (port 6543):
# DB_DISABLE_SERVER_SIDE_CURSORS=True

# Tests use a separate database or Supabase project/branch. When unset the
# suite falls back to in-memory SQLite; never point this at production.
# TEST_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/mystudio_test

# --- JWT ---------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_LEEWAY_SECONDS=10

# --- Rate limiting (public auth endpoints) ------------------------------
# DRF throttle rates: number/period (s, m, h, d).
AUTH_LOGIN_THROTTLE=5/min
AUTH_REFRESH_THROTTLE=20/min
AUTH_VERIFY_THROTTLE=20/min

# Shared cache. Required in production so every worker sees the same
# throttle counters. Leave unset for a single-process development server.
# CACHE_URL=redis://localhost:6379/1

# Public API documentation. Development enables it; production restricts the
# schema, Swagger UI and ReDoc to staff accounts unless this is set to True.
# API_DOCS_PUBLIC=False

# --- Email (console backend in development) ----------------------------
# MAILERS_DEFAULT_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MyStudio <no-reply@mystudio.ng>

# --- Paystack (not integrated yet - future payments milestone) ---------
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# --- Cloudinary (studio and equipment images) --------------------------
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Maximum accepted upload size in bytes (default 5 MB).
# IMAGE_UPLOAD_MAX_BYTES=5242880

# --- Resend (not integrated yet - future email milestone) --------------
RESEND_API_KEY=re_your_resend_api_key

# --- Production-only ---------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
# Error-mail recipients, comma-separated: "Ops <ops@mystudio.ng>"
# ADMINS=
